# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit secrets.
# spring-dotenv auto-loads `.env` from the working directory when you run
# `./mvnw spring-boot:run` from `backend/`.

# Required ---------------------------------------------------------------

# A random string of 32+ characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-string-of-at-least-32-characters

# OAuth 2.0 Web client id from Google Cloud Console.
# Authorize http://localhost:4200 as a JavaScript origin on this client.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Comma-separated email domains accepted at Google sign-in (no spaces).
# Override the default (`synacy.com,rise.com`) here when deploying to a
# different org, or extending to a partner domain.
ALLOWED_DOMAINS=synacy.com,rise.com

# Comma-separated list of admin emails (no spaces around commas).
# Users whose verified Google email matches one of these get the admin
# dashboard and the /api/v1/admin/** endpoints. Leave empty to have no
# admins yet.
ADMIN_EMAILS=manuel.ortega@synacy.com

# Earned points added to a user's redeemable balance once per year on their
# birthday. Default is 20 if unset. Treat it as a birthday gift to spend
# on rewards, not extra giving allowance.
BIRTHDAY_TOP_UP=20

# --- Email notifications (optional) ---
# Set these to enable email delivery alongside the in-app notification bell.
# Leave SMTP_HOST blank to disable email entirely — in-app notifications
# still work. Common providers:
#  - Resend:    smtp.resend.com / 587 / "resend" / <your-resend-api-key>
#  - SendGrid:  smtp.sendgrid.net / 587 / "apikey" / <your-sendgrid-api-key>
#  - Brevo:     smtp-relay.brevo.com / 587 / <login> / <smtp-key>
#  - Gmail:     smtp.gmail.com / 587 / <gmail-address> / <app-password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@buhosly.demo

# Public URL of the SPA so notification email links work in prod.
# Leave unset for local dev; falls back to http://localhost:4200.
WEB_BASE_URL=

# Giphy API key for the in-app GIF search.
# Get one at https://developers.giphy.com (Create an App → API).
# Without it, /api/v1/gifs returns HTTP 503; emojis still work.
GIPHY_API_KEY=

# Optional (defaults below match docker-compose.yml) ---------------------

# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/buhosly
# SPRING_DATASOURCE_USERNAME=buhosly
# SPRING_DATASOURCE_PASSWORD=buhosly
