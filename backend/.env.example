# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit secrets.
# spring-dotenv auto-loads `.env` from the working directory when you run
# `./mvnw spring-boot:run` from `backend/`.

# Required ---------------------------------------------------------------

# A random string of 32+ characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-string-of-at-least-32-characters

# OAuth 2.0 Web client id from Google Cloud Console.
# Authorize http://localhost:4200 as a JavaScript origin on this client.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Giphy API key for the in-app GIF search.
# Get one at https://developers.giphy.com (Create an App → API).
# Without it, /api/v1/gifs returns HTTP 503; emojis still work.
GIPHY_API_KEY=

# Optional (defaults below match docker-compose.yml) ---------------------

# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/buhosly
# SPRING_DATASOURCE_USERNAME=buhosly
# SPRING_DATASOURCE_PASSWORD=buhosly
